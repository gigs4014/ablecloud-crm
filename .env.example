# ── 데이터베이스 ─────────────────────────────────────────
POSTGRES_USER=erm
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=erm
DATABASE_URL=postgresql://erm:change-me-db-password@postgres:5432/erm?schema=public

# ── Redis (작업 큐) ─────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── 보안 ────────────────────────────────────────────────
# 32바이트 이상 임의 문자열. 생성: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# 개인정보 컬럼 암호화 키 (32바이트를 base64로). 생성: openssl rand -base64 32
# 분실하면 암호화된 데이터를 복구할 수 없으니 별도로 안전하게 보관하세요.
DATA_ENCRYPTION_KEY=

# ── 서비스 ──────────────────────────────────────────────
APP_TIMEZONE=Asia/Seoul
WEB_PORT=3000
# 운영에서 HTTPS 뒤에 둘 때 true
COOKIE_SECURE=false

# ── 초기 데이터 (seed) ─────────────────────────────────
SEED_TENANT_NAME=우리회사
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# true면 화면 확인용 예시 직원과 데이터를 넣습니다 (운영에서는 false)
SEED_DEMO=false

# ── 외부 연동 ───────────────────────────────────────────
# internal: 자체 캘린더/알림만 사용, synology: 시놀로지 연동 사용
INTEGRATION_PROVIDER=internal
SYNOLOGY_BASE_URL=
SYNOLOGY_CHAT_WEBHOOK_URL=
SYNOLOGY_CALDAV_URL=
SYNOLOGY_CALDAV_USERNAME=
SYNOLOGY_CALDAV_PASSWORD=
