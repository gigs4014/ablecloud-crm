{
  "name": "erm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @erm/db generate",
    "db:migrate": "pnpm --filter @erm/db build && pnpm --filter @erm/db migrate:deploy",
    "db:deploy": "pnpm --filter @erm/db migrate:deploy",
    "db:seed": "pnpm --filter @erm/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "msgpackr-extract",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
